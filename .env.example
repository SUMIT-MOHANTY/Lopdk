# =============================================================================
# Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------

# SECRET_KEY — Required. A long, random, unique string used for cryptographic
# signing. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NEVER share or commit this value.
SECRET_KEY=your-very-long-random-secret-key-here

# DEBUG — Set to True only during local development.
# Must be False in production to prevent sensitive data leakage.
# Accepted values: True | False
DEBUG=False

# ALLOWED_HOSTS — Comma-separated list of host/domain names this Django site
# can serve. Must NOT contain '*' in production.
# Example: ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# DJANGO_SETTINGS_MODULE — Which settings file Django should use.
# Use config.settings.production for production deployments.
DJANGO_SETTINGS_MODULE=config.settings.production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# DATABASE_URL — Full database connection URL.
# Examples:
#   SQLite  (development): sqlite:///db.sqlite3
#   PostgreSQL (production): postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# -----------------------------------------------------------------------------
# Security (Production Only)
# -----------------------------------------------------------------------------

# SECURE_SSL_REDIRECT — Redirect all HTTP requests to HTTPS.
# Set to False only if SSL termination is handled upstream (e.g., load balancer).
# Accepted values: True | False  (default: True in production)
SECURE_SSL_REDIRECT=True

# CORS_ALLOWED_ORIGINS — Comma-separated list of origins allowed for CORS.
# Example: CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Email (Optional)
# -----------------------------------------------------------------------------

# EMAIL_HOST — SMTP host for sending emails (optional).
# EMAIL_HOST=smtp.example.com

# EMAIL_PORT — SMTP port (default: 587 for TLS).
# EMAIL_PORT=587

# EMAIL_HOST_USER — SMTP username.
# EMAIL_HOST_USER=your-email@example.com

# EMAIL_HOST_PASSWORD — SMTP password.
# EMAIL_HOST_PASSWORD=your-email-password

# EMAIL_USE_TLS — Enable TLS for email. Accepted values: True | False
# EMAIL_USE_TLS=True
