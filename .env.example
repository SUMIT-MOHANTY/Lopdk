# ---------------------------------------------------------------------------
# .env.example — Environment variable template
#
# Copy this file to .env and fill in the values for your environment.
# The .env file is listed in .gitignore and must NEVER be committed.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# REQUIRED — A long, random, unique string used for cryptographic signing.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here

# Set to True for local development, False for staging/production.
# NEVER set to True in production.
DEBUG=True

# Comma-separated list of hostnames/IPs the Django app is allowed to serve.
# Examples: localhost,127.0.0.1   or   example.com,www.example.com
# Use * to allow all hosts (development only).
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (future — currently SQLite is used by default)
# ---------------------------------------------------------------------------

# Full database URL for PostgreSQL (uncomment when switching from SQLite).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgres://postgres:password@localhost:5432/mydb

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed to make cross-site requests.
# Example: http://localhost:3000,https://app.example.com
# Only used in production (development allows all origins).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Security (production only)
# ---------------------------------------------------------------------------

# Set to False to disable automatic HTTP → HTTPS redirect (useful behind a
# TLS-terminating proxy that already handles redirection).
# SECURE_SSL_REDIRECT=True
